{
  "info": {
    "name": "Document Sharing API - Day 2 Documents",
    "description": "Run the Day 1 auth collection registration once, then use the same Alex account below. Select local files in the form-data file fields before sending upload requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000" },
    { "key": "token", "value": "" },
    { "key": "document_id", "value": "" }
  ],
  "item": [
    {
      "name": "Login (save bearer token)",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('login succeeds', () => pm.response.to.have.status(200));", "pm.collectionVariables.set('token', pm.response.json().access_token);"] } }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"alex@example.com\",\n  \"password\": \"correct-horse-123\"\n}", "options": { "raw": { "language": "json" } } },
        "url": "{{base_url}}/api/v1/auth/login"
      }
    },
    {
      "name": "Upload one document",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('document created', () => pm.response.to.have.status(201));", "pm.collectionVariables.set('document_id', pm.response.json().id);"] } }],
      "request": {
        "method": "POST",
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
        "body": { "mode": "formdata", "formdata": [{ "key": "file", "type": "file", "src": "" }] },
        "url": "{{base_url}}/api/v1/documents"
      }
    },
    {
      "name": "Upload multiple documents",
      "request": {
        "method": "POST",
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
        "body": { "mode": "formdata", "formdata": [{ "key": "files", "type": "file", "src": "" }, { "key": "files", "type": "file", "src": "" }] },
        "url": "{{base_url}}/api/v1/documents/bulk"
      }
    },
    {
      "name": "List, filter, sort, paginate documents",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('document page returned', () => pm.response.to.have.status(200));", "const page = pm.response.json();", "pm.test('pagination fields returned', () => pm.expect(page).to.have.keys('items', 'total', 'page', 'page_size', 'pages'));"] } }],
      "request": {
        "method": "GET",
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
        "url": "{{base_url}}/api/v1/documents?page=1&page_size=20&sort_by=uploaded_at&sort_order=desc"
      }
    },
    {
      "name": "Get document metadata",
      "request": {
        "method": "GET",
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
        "url": "{{base_url}}/api/v1/documents/{{document_id}}"
      }
    },
    {
      "name": "Download document",
      "request": {
        "method": "GET",
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
        "url": "{{base_url}}/api/v1/documents/{{document_id}}/download"
      }
    },
    {
      "name": "Delete document",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('document deleted', () => pm.response.to.have.status(204));"] } }],
      "request": {
        "method": "DELETE",
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
        "url": "{{base_url}}/api/v1/documents/{{document_id}}"
      }
    }
  ]
}
